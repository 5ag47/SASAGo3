{
  "name": "sasago3",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:secure": "node --env-file-if-exists=.env.local tools/dev-secure.mjs",
    "build": "vite build",
    "build:secure": "node --env-file-if-exists=.env.local tools/build-secure.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test \"src/**/*.test.js\" \"tests/**/*.test.js\"",
    "check": "node tools/validate-content.mjs && node tools/check-architecture.mjs && eslint .",
    "lint": "eslint .",
    "check:staged": "node tools/check-staged.mjs",
    "cloud:secret": "node tools/provision-cloud-secret.mjs",
    "cloud:deploy": "npm run build:secure && wrangler deploy",
    "smoke:public": "node tools/smoke-public.mjs",
    "smoke:d1": "node tools/smoke-d1.mjs",
    "format": "prettier --write data src/domain src/features/year-game src/platform server tests tools docs README.md package.json vite.config.js src/main.jsx",
    "start:secure": "node --env-file-if-exists=.env.local server/node.mjs"
  },
  "dependencies": {
    "firebase": "^13.1.0",
    "jose": "^6.2.13",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "^3.9.10",
    "vite": "^6.4.5",
    "wrangler": "4.131.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "sharp": "^0.35.5",
    "undici": "^7.30.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
