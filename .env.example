# Copy to .env.local. Public Firebase web configuration; never paste service-account private keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# false = personal browser save, true = Google-authenticated authoritative server.
# dev:secure sets this automatically; set true before building the deployed server version.
VITE_SERVER_MODE=false
PUBLIC_ORIGIN=http://localhost:5173
API_PORT=4174
# Production only: generate a random secret locally; never prefix it with VITE_.
# PLAYER_ID_SECRET=
